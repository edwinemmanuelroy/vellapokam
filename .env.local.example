# =============================================================================
# Kerala Flood Emergency Dashboard — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in your Supabase project credentials.
#
#   cp .env.local.example .env.local
#
# Both values are available from your Supabase project dashboard:
#   Settings → API → Project URL / anon (public) key
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Proximity push notifications (optional — the app runs without them)
# -----------------------------------------------------------------------------
# Alerts nearby people when someone files an SOS within 25 km, and pushes
# red/orange government warnings. Leave blank to disable: the consent UI hides
# itself and the /api/push/* routes return 503 rather than failing loudly.
#
# 1. Generate a VAPID keypair (identifies this server to push services):
#      npx web-push generate-vapid-keys
# 2. SUPABASE_SERVICE_ROLE_KEY: Supabase → Settings → API → service_role.
#    SERVER-ONLY — it bypasses RLS. Never prefix it with NEXT_PUBLIC_.
# 3. PUSH_WEBHOOK_SECRET: any long random string, e.g. `openssl rand -hex 32`.
#    Set the same value as the `x-webhook-secret` header on the Supabase
#    Database Webhook (Database → Webhooks → sos_requests INSERT →
#    POST https://<your-host>/api/push/dispatch).
# 4. CRON_SECRET (optional): only if you use Vercel Cron for the alert sweep.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.org
SUPABASE_SERVICE_ROLE_KEY=
PUSH_WEBHOOK_SECRET=
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Basemap tiles (optional overrides)
# -----------------------------------------------------------------------------
# Defaults to OpenStreetMap's public tile server (free, attribution required).
# If OSM throttles under event-scale traffic, point these at a keyed provider
# (MapTiler / Stadia / self-hosted) — no code change or redeploy logic needed.
# Attribution MUST credit the data source; OSM-derived maps must credit
# "© OpenStreetMap contributors".
#
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
